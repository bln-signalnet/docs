  "keyFeatures": [
    "Send and receive SMS and MMS messages",
    "Initiate and manage voice calls",
    "Twilio and SignalWire drop-in compatible API",
    "Webhook callbacks for inbound SMS and call status events",
    "HTTP Basic Auth with Account SID and Auth Token",
    "Paginated message and call list endpoints",
    "TwiML/LaML XML response support"
  ],
  "publicApiSurface": [
    "POST /api/laml/2010-04-01/Accounts/{AccountSid}/Messages.json",
    "GET /api/laml/2010-04-01/Accounts/{AccountSid}/Messages.json",
    "POST /api/laml/2010-04-01/Accounts/{AccountSid}/Calls.json",
    "GET /api/laml/2010-04-01/Accounts/{AccountSid}/Calls.json",
    "Webhook: POST /webhooks/sms (incoming SMS)",
    "Webhook: POST /webhooks/voice (call status)"
  ]
